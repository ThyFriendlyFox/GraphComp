{
  "name": "graphcomp",
  "private": true,
  "version": "0.0.0",
  "description": "Copy-paste components for node-based canvas interfaces. Built on React Flow, Tailwind CSS and Motion.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && pnpm registry:build && vite build",
    "registry:build": "shadcn build --output public/r",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "verify": "bash verify/verify.sh",
    "gifs": "node scripts/record-gifs.mjs",
    "assets": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^13.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
