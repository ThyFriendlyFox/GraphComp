{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "graphcomp",
  "homepage": "https://github.com/ThyFriendlyFox/GraphComp",
  "items": [
    {
      "name": "graphcomp-theme",
      "type": "registry:file",
      "title": "GraphComp Theme",
      "description": "Design tokens for every GraphComp component, in light and dark, plus React Flow overrides.",
      "files": [
        {
          "path": "registry/graphcomp/styles/graphcomp.css",
          "type": "registry:file",
          "target": "styles/graphcomp.css"
        }
      ],
      "docs": "Import the theme once in your global CSS, after Tailwind and React Flow:\n\n  @import \"tailwindcss\";\n  @import \"@xyflow/react/dist/base.css\";\n  @import \"./styles/graphcomp.css\";"
    },
    {
      "name": "use-controllable-state",
      "type": "registry:hook",
      "title": "useControllableState",
      "description": "State that a parent may control or leave to the component.",
