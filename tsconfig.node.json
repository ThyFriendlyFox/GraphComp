{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx"
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "verify",
    "scripts/seo.ts",
    "site/content/pages.ts",
    "site/components/useful-shelf-badge.tsx"
  ]
}
